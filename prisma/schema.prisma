generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuditLog {
  id                String        @id @default(cuid())
  userId            String?
  action            String
  resource          String
  resourceId        String?
  oldValues         Json?
  newValues         Json?
  ipAddress         String?
  userAgent         String?
  organizationId    String?
  permissionContext Json?
  riskAssessment    String?
  approvalChain     String[]
  createdAt         DateTime      @default(now())
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([organizationId])
  @@index([createdAt])
  @@index([riskAssessment])
  @@map("audit_logs")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  emailVerified          DateTime?
  name                   String?
  firstName              String?
  lastName               String?
  phone                  String?                 @unique
  image                  String?
  jobTitle               String?
  password               String
  isActive               Boolean                 @default(true)
  isVerified             Boolean                 @default(false)
  token                  String?
  lastLoginAt            DateTime?
  passwordChangedAt      DateTime?
  failedLoginAttempts    Int                     @default(0)
  lockedUntil            DateTime?
  twoFactorEnabled       Boolean                 @default(false)
  twoFactorSecret        String?
  backupCodes            String[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organizationId         String
  accounts               Account[]
  auditLogs              AuditLog[]
  cashDrawerTransactions CashDrawerTransaction[]
  dailyReports           DailySalesReport[]
  receivedGoodsReceipts  GoodsReceipt[]          @relation("GoodsReceiptReceivedBy")
  createdTransactions    InventoryTransaction[]  @relation("TransactionCreatedBy")
  managedLocations       Location[]              @relation("LocationManager")
  refundsProcessed       PaymentRefund[]
  paymentsProcessed      Payment[]
  requestedApprovals     PermissionApproval[]    @relation("PermissionRequester")
  reviewedApprovals      PermissionApproval[]    @relation("PermissionReviewer")
  PermissionApproval     PermissionApproval[]
  grantedPermSessions    PermissionSession[]     @relation("PermissionSessionGranter")
  revokedPermSessions    PermissionSession[]     @relation("PermissionSessionRevoker")
  PermissionSession      PermissionSession[]
  posSessions            POSSession[]
  approvedPurchaseOrders PurchaseOrder[]         @relation("PurchaseOrderApprovedBy")
  createdPurchaseOrders  PurchaseOrder[]         @relation("PurchaseOrderCreatedBy")
  grantedResourcePerms   ResourcePermission[]    @relation("ResourcePermissionGranter")
  ResourcePermission     ResourcePermission[]
  ownedResources         Resource[]              @relation("ResourceOwner")
  grantedRolePermissions RolePermission[]        @relation("RolePermissionGranter")
  createdSalesOrders     SalesOrder[]            @relation("SalesOrderCreatedBy")
  sessions               Session[]
  approvedAdjustments    StockAdjustment[]       @relation("AdjustmentApprovedBy")
  createdAdjustments     StockAdjustment[]       @relation("AdjustmentCreatedBy")
  approvedTransfers      StockTransfer[]         @relation("TransferApprovedBy")
  createdTransfers       StockTransfer[]         @relation("TransferCreatedBy")
  grantedUserPermissions UserPermission[]        @relation("UserPermissionGranter")
  userPermissions        UserPermission[]
  revokedSessions        UserSession[]           @relation("SessionRevoker")
  userSessions           UserSession[]

  // Presence System Relations
  presenceSessions         EmployeePresenceSession[] @relation("EmployeePresenceSessions")
  approvedPresenceSessions EmployeePresenceSession[] @relation("ApprovedPresenceSessions")
  activityLogs             EmployeeActivityLog[]     @relation("EmployeeActivityLogs")
  breakSessions            EmployeeBreakSession[]    @relation("EmployeeBreakSessions")
  approvedBreakSessions    EmployeeBreakSession[]    @relation("ApprovedBreakSessions")
  schedules                EmployeeSchedule[]        @relation("EmployeeSchedules")
  presenceAlerts           PresenceAlert[]           @relation("EmployeePresenceAlerts")
  resolvedPresenceAlerts   PresenceAlert[]           @relation("ResolvedPresenceAlerts")
  attendanceReports        AttendanceReport[]        @relation("EmployeeAttendanceReports")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        Role[]       @relation("UserRoles")

  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([lastLoginAt])
  @@index([isActive])
  @@map("users")
}

model Role {
  id                   String               @id @default(cuid())
  name                 String
  code                 String
  description          String?
  permissions          String[]
  parentId             String?
  isSystemRole         Boolean              @default(false)
  hierarchyLevel       Int                  @default(999)
  maxUsers             Int?
  validFrom            DateTime?
  validUntil           DateTime?
  locationRestrictions String[]
  conditions           Json?
  isActive             Boolean              @default(true)
  organizationId       String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  resourcePermissions  ResourcePermission[]
  rolePermissions      RolePermission[]
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent               Role?                @relation("RoleHierarchy", fields: [parentId], references: [id])
  children             Role[]               @relation("RoleHierarchy")
  users                User[]               @relation("UserRoles")

  @@unique([organizationId, code])
  @@index([code])
  @@index([parentId])
  @@index([organizationId, hierarchyLevel])
  @@map("roles")
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  industry              String?
  country               String?
  state                 String?
  address               String?
  currency              String                 @default("USD")
  timezone              String                 @default("UTC")
  inventoryStartDate    DateTime?
  fiscalYearStart       String?                @default("01-01")
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditLogs             AuditLog[]
  brands                Brand[]
  categories            Category[]
  customers             Customer[]
  dailySalesReports     DailySalesReport[]
  goodsReceipts         GoodsReceipt[]
  inventoryTransactions InventoryTransaction[]
  invites               Invite[]
  items                 Item[]
  locations             Location[]
  posStations           POSStation[]
  purchaseOrders        PurchaseOrder[]
  resources             Resource[]
  roles                 Role[]
  salesOrders           SalesOrder[]
  stockAdjustments      StockAdjustment[]
  stockTransfers        StockTransfer[]
  suppliers             Supplier[]
  taxRates              TaxRate[]
  units                 Unit[]
  users                 User[]

  // Presence System Relations
  presenceSessions  EmployeePresenceSession[] @relation("OrganizationPresenceSessions")
  schedules         EmployeeSchedule[]        @relation("OrganizationSchedules")
  presenceAlerts    PresenceAlert[]           @relation("OrganizationPresenceAlerts")
  attendanceReports AttendanceReport[]        @relation("OrganizationAttendanceReports")

  @@index([slug])
  @@index([isActive])
  @@map("organizations")
}

model Permission {
  id                 String           @id @default(cuid())
  name               String
  code               String           @unique
  resource           String
  action             String
  description        String?
  category           String
  isSystemPermission Boolean          @default(false)
  requiresApproval   Boolean          @default(false)
  riskLevel          RiskLevel        @default(LOW)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  rolePermissions    RolePermission[]
  userPermissions    UserPermission[]

  @@unique([resource, action])
  @@index([category])
  @@index([resource])
  @@index([riskLevel])
  @@map("permissions")
}

model Resource {
  id                  String               @id @default(cuid())
  resourceType        String
  resourceId          String
  organizationId      String
  ownerId             String?
  visibility          ResourceVisibility   @default(PRIVATE)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  permissionApprovals PermissionApproval[]
  resourcePermissions ResourcePermission[]
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User?                @relation("ResourceOwner", fields: [ownerId], references: [id])
  userPermissions     UserPermission[]

  @@unique([resourceType, resourceId, organizationId])
  @@index([organizationId, resourceType])
  @@index([ownerId])
  @@map("resources")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  conditions   Json?
  grantedBy    String?
  grantedAt    DateTime   @default(now())
  expiresAt    DateTime?
  isActive     Boolean    @default(true)
  granter      User?      @relation("RolePermissionGranter", fields: [grantedBy], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([expiresAt])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  resourceId   String?
  conditions   Json?
  grantedBy    String
  grantedAt    DateTime   @default(now())
  expiresAt    DateTime?
  reason       String?
  isActive     Boolean    @default(true)
  granter      User       @relation("UserPermissionGranter", fields: [grantedBy], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  resource     Resource?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, resourceId])
  @@index([userId])
  @@index([permissionId])
  @@index([resourceId])
  @@index([expiresAt])
  @@map("user_permissions")
}

model ResourcePermission {
  id             String    @id @default(cuid())
  resourceId     String
  userId         String?
  roleId         String?
  permissionType String
  grantedBy      String
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?
  conditions     Json?
  granter        User      @relation("ResourcePermissionGranter", fields: [grantedBy], references: [id])
  resource       Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  role           Role?     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([userId])
  @@index([roleId])
  @@index([expiresAt])
  @@map("resource_permissions")
}

model PermissionSession {
  id          String                @id @default(cuid())
  userId      String
  sessionType PermissionSessionType
  permissions String[]
  context     Json?
  grantedBy   String
  grantedAt   DateTime              @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedBy   String?
  reason      String?
  granter     User                  @relation("PermissionSessionGranter", fields: [grantedBy], references: [id])
  revoker     User?                 @relation("PermissionSessionRevoker", fields: [revokedBy], references: [id])
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionType])
  @@map("permission_sessions")
}

model PermissionApproval {
  id                   String         @id @default(cuid())
  userId               String
  requestedPermissions String[]
  resourceId           String?
  justification        String
  status               ApprovalStatus @default(PENDING)
  requestedBy          String
  requestedAt          DateTime       @default(now())
  reviewedBy           String?
  reviewedAt           DateTime?
  approvedUntil        DateTime?
  reviewNotes          String?
  requester            User           @relation("PermissionRequester", fields: [requestedBy], references: [id])
  resource             Resource?      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reviewer             User?          @relation("PermissionReviewer", fields: [reviewedBy], references: [id])
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@map("permission_approvals")
}

model UserSession {
  id                  String    @id @default(cuid())
  userId              String
  sessionToken        String    @unique
  deviceInfo          Json?
  ipAddress           String?
  location            String?
  permissionsSnapshot String[]
  createdAt           DateTime  @default(now())
  lastActivity        DateTime  @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  revokedBy           String?
  revoker             User?     @relation("SessionRevoker", fields: [revokedBy], references: [id])
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@index([lastActivity])
  @@map("user_sessions")
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@index([email])
  @@map("invites")
}

model Location {
  id                    String                 @id @default(cuid())
  name                  String
  code                  String
  type                  LocationType           @default(WAREHOUSE)
  address               String?
  phone                 String?
  email                 String?
  isActive              Boolean                @default(true)
  isDefault             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organizationId        String
  managerId             String?
  allowNegativeStock    Boolean                @default(false)
  requiresApproval      Boolean                @default(false)
  cashDrawers           CashDrawer[]
  dailySalesReports     DailySalesReport[]
  goodsReceipts         GoodsReceipt[]
  inventoryLevels       InventoryLevel[]
  inventoryTransactions InventoryTransaction[]
  manager               User?                  @relation("LocationManager", fields: [managerId], references: [id])
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  POSSession            POSSession[]
  posStations           POSStation[]
  purchaseOrders        PurchaseOrder[]
  salesOrders           SalesOrder[]
  stockAdjustments      StockAdjustment[]
  transfersFrom         StockTransfer[]        @relation("TransferFrom")
  transfersTo           StockTransfer[]        @relation("TransferTo")

  // Presence System Relations
  presenceSessions  EmployeePresenceSession[] @relation("LocationPresenceSessions")
  schedules         EmployeeSchedule[]        @relation("LocationSchedules")
  attendanceReports AttendanceReport[]        @relation("LocationAttendanceReports")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@map("locations")
}

model Category {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  description    String?
  imageUrl       String?
  parentId       String?
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  items          Item[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("categories")
}

model Brand {
  id             String       @id @default(cuid())
  brandName      String
  slug           String       @unique
  description    String?
  logoUrl        String?
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          Item[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

model Unit {
  id             String       @id @default(cuid())
  name           String
  symbol         String
  type           UnitType     @default(QUANTITY)
  baseUnit       String?
  conversionRate Float?
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          Item[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units")
}

model TaxRate {
  id             String       @id @default(cuid())
  taxRateName    String
  rate           Float
  taxType        TaxType // @default(SALES)
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          Item[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, taxRateName])
  @@index([organizationId])
  @@map("tax_rates")
}

model Item {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  sku                   String                 @unique
  barcode               String?                @unique
  description           String?
  imageUrls             String
  thumbnail             String?
  upc                   String?
  ean                   String?
  mpn                   String?
  isbn                  String?
  dimensions            String?
  weight                Float?
  color                 String?
  size                  String?
  costPrice             Float                  @default(0)
  sellingPrice          Float                  @default(0)
  msrp                  Float?
  trackInventory        Boolean                @default(true)
  trackSerialNumbers    Boolean                @default(false)
  trackBatches          Boolean                @default(false)
  trackExpiry           Boolean                @default(false)
  minStockLevel         Int                    @default(0)
  maxStockLevel         Int?
  reorderLevel          Int                    @default(0)
  reorderQuantity       Int?
  isActive              Boolean                @default(true)
  isDiscontinued        Boolean                @default(false)
  organizationId        String
  categoryId            String?
  brandId               String?
  unitId                String?
  taxRateId             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  DailySalesReportItem  DailySalesReportItem[]
  dailySalesReports     DailySalesReport[]
  goodsReceiptLines     GoodsReceiptLine[]
  inventoryLevels       InventoryLevel[]
  inventoryTransactions InventoryTransaction[]
  supplierItems         ItemSupplier[]
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id])
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate               TaxRate?               @relation(fields: [taxRateId], references: [id])
  unit                  Unit?                  @relation(fields: [unitId], references: [id])
  purchaseOrderLines    PurchaseOrderLine[]
  salesOrderLines       SalesOrderLine[]
  serialNumbers         SerialNumber[]
  adjustmentLines       StockAdjustmentLine[]
  transferLines         StockTransferLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([categoryId])
  @@index([brandId])
  @@index([barcode])
  @@map("items")
}

model InventoryLevel {
  id                String    @id @default(cuid())
  itemId            String
  locationId        String
  quantityOnHand    Int       @default(0)
  quantityReserved  Int       @default(0)
  quantityAvailable Int       @default(0)
  quantityInTransit Int       @default(0)
  quantityOnOrder   Int       @default(0)
  reorderPoint      Int       @default(0)
  averageCost       Float     @default(0)
  totalValue        Float     @default(0)
  lastCountDate     DateTime?
  lastTransactionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
  @@map("inventory_levels")
}

model InventoryTransaction {
  id              String                    @id @default(cuid())
  type            TransactionType
  quantity        Int
  unitCost        Float                     @default(0)
  totalCost       Float                     @default(0)
  notes           String?
  createdAt       DateTime                  @default(now())
  itemId          String
  locationId      String
  organizationId  String
  createdById     String?
  referenceType   TransactionReferenceType?
  referenceId     String?
  referenceNumber String?
  batchNumber     String?
  serialNumbers   String[]
  expiryDate      DateTime?
  balanceAfter    Int
  createdBy       User?                     @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  item            Item                      @relation(fields: [itemId], references: [id])
  location        Location                  @relation(fields: [locationId], references: [id])
  organization    Organization              @relation(fields: [organizationId], references: [id])

  @@index([itemId])
  @@index([locationId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model SerialNumber {
  id           String       @id @default(cuid())
  serialNumber String       @unique
  status       SerialStatus @default(AVAILABLE)
  itemId       String
  locationId   String?
  batchNumber  String?
  expiryDate   DateTime?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  item         Item         @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([status])
  @@map("serial_numbers")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  code           String?         @unique
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  taxId          String?
  paymentTerms   Int?            @default(30)
  creditLimit    Float?
  notes          String?
  isActive       Boolean         @default(true)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplierItems  ItemSupplier[]
  purchaseOrders PurchaseOrder[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("suppliers")
}

model ItemSupplier {
  id               String    @id @default(cuid())
  itemId           String
  supplierId       String
  supplierSku      String?
  supplierName     String?
  isPreferred      Boolean   @default(false)
  leadTimeDays     Int?
  minOrderQuantity Int?
  unitCost         Float?
  lastPurchaseDate DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([itemId, supplierId])
  @@index([supplierId])
  @@map("item_suppliers")
}

model Customer {
  id             String       @id @default(cuid())
  name           String
  code           String?      @unique
  email          String?
  phone          String?
  address        String?
  taxId          String?
  creditLimit    Float?
  paymentTerms   Int?         @default(30)
  notes          String?
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrders    SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  orderNumber          String              @unique
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  paymentTerms         String?
  notes                String?
  internalNotes        String?
  subtotal             Float               @default(0)
  taxAmount            Float               @default(0)
  shippingCost         Float               @default(0)
  discount             Float               @default(0)
  total                Float               @default(0)
  supplierId           String
  locationId           String
  organizationId       String
  createdById          String?
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  goodsReceipts        GoodsReceipt[]
  payments             Payment[]
  lines                PurchaseOrderLine[]
  approvedBy           User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  createdBy            User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  location             Location            @relation(fields: [locationId], references: [id])
  organization         Organization        @relation(fields: [organizationId], references: [id])
