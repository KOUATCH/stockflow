  @@index([userId])
  @@index([locationId])
  @@index([organizationId])
  @@index([status])
  @@index([clockInTime])
  @@map("employee_presence_sessions")
}

model EmployeeActivityLog {
  id                String       @id @default(cuid())
  presenceSessionId String
