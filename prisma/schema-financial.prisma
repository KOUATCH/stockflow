}

enum ReportStatus {
  DRAFT
  GENERATED
  REVIEWED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum BudgetType {
  OPERATING
  CAPITAL
  CASH_FLOW
  PROJECT
  DEPARTMENT
  MASTER
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FinancialRatioType {
  LIQUIDITY
  LEVERAGE
  PROFITABILITY
  EFFICIENCY
  MARKET
}

enum TrendDirection {
  IMPROVING
  DECLINING
  STABLE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaxType {
  SALES_TAX
  INCOME_TAX
  PAYROLL_TAX
  PROPERTY_TAX
  EXCISE_TAX
  VAT
