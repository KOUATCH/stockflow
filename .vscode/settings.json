  // "java.compile.nullAnalysis.mode": "automatic",
  // "java.configuration.updateBuildConfiguration": "automatic",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.quickSuggestions": {
    "other": true, 
    "comments": true,
    "strings": true
    // "terminal.integrated.shell.windows": "C:\\Windows\\sys32\\bash.exe",
    // "terminal.integrated.shellArgs.windows": ["-c", "zsh"],
  },
  // "terminal.integrated.shell.linux": "/user/bin/zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.defaultProfile.linux": "/user/bin/zsh",
  // "terminal.integrated.fontFamily": "'FiraCode Nerd Font','JetBrainsMono Nerd Font Mono','MesloLGM Nerd Font', monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontFamily":"'FantastiqueSansMono', 'FiraCode Nerd Font', 'JetBrainsMono Nerd Font Mono', 'MesloLGM Nerd Font', monospace",
  // "terminal.integrated.defaultProfile.windows": "Git Bash",
  // "editor.fontFamily": "'FiraCode Nerd Font', 'JetBrains Mono NL', 'Cascadia Code NF', Consolas, 'Courier New', monospace",
  // "terminal.integrated.fontFamily": "'FiraCode Nerd Font', 'JetBrains Mono NL', 'Cascadia Code NF'",
// "editor.fontLigatures": true,
 "editor.fontLigatures": "'calt', 'liga', 'clig', 'kern'",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "mouseover",
  "editor.minimap.size": "fill",
  "editor.minimap.scale": 3,
  "terminal.integrated.fontSize":13,
"terminal.integrated.fontWeight": "bold",
  "editor.minimap.side": "right",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  
  "editor.detectIndentation": false,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 80,
  "editor.wrappingIndent": "same",
  // "window.titleBarStyle": "custom",
  "editor.suggestSelection": "first",
  "editor.formatOnSave": true,
  "editor.autoClosingQuotes": "always",
  "editor.formatOnPaste": true,  
  "explorer.openEditors.visible": 1,
  "explorer.sortOrder": "default",
  "git.enableSmartCommit": true,
  "prettier.enable": true,
  "typescript.suggest.paths": false,
  "files.exclude": {
    "**/node_modules": true,
    "**/bin": true,
    "**/.install": true,
    "**/.next": true,
    "**/.vscode": true
  },
  "prettier.bracketSpacing": true,
  "prettier.requireConfig": true,

  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "javascript.updateImportsOnFileMove.enabled": "always",
 
  "diffEditor.renderSideBySide": false,
  "editor.cursorBlinking": "expand",
  "terminal.integrated.cursorBlinking": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "block",
  "editor.fontSize": 15,
  "window.zoomLevel":1,
  "workbench.iconTheme": "a-file-icon-vscode",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.highlightActiveBracketPair": true,
  "workbench.colorTheme": "Retreon",
  
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "typescript": "typescript",
    "javascriptreact": "javascriptreact",
    "typescriptreact": "typescriptreact"
  },
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.experimental.classAttributes": [
    "class",
    "className",
    "ngClass",
    "tw",
    "twClass",
    "twClasses"
  ],    
  "tailwindCSS.experimental.classRegex": [
    "tw`([^`]*)",
    "tw\\(([^)]*)\\)",
    "tw\\s*[:=]\\s*['\"`]([^'\"`]*)['\"`]",
    "twClass\\s*[:=]\\s*['\"`]([^'\"`]*)['\"`]",
    "twClasses\\s*[:=]\\s*['\"`]([^'\"`]*)['\"`]"
  ],

  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  // "tailwindCSS.experimental.classRegex": [
  //   "class[Name]*\\s*[:=]\\s*['\"`]([^'\"`]*)['\"`]",
  //   "className\\s*[:=]\\s*['\"`]([^'\"`]*)['\"`]",
  //   "\\bclass:\\s*['\"`]([^'\"`]*)['\"`]"
  // ],
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list"
  ],
  "tailwindCSS.suggestions": true,
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidScreen": "error",
  "tailwindCSS.lint.invalidTailwindDirective": "error",
  "tailwindCSS.lint.invalidVariant": "error",
  "tailwindCSS.lint.recommendedVariantOrder": "warning",
  // "terminal.integrated.fontFamily": "Delugia Book",
  // "editor.fontFamily": "'Fira Code'", 
  "terminal.integrated.gpuAcceleration": "on",
  // "editor.fontFamily": "'FiraCode Nerd Font','JetBrainsMono Nerd Font Mono','MesloLGM Nerd Font' monospace",
  "editor.fontFamily": "'FantastiqueSansMono', 'FiraCode Nerd Font', 'JetBrainsMono Nerd Font Mono', 'MesloLGM Nerd Font', monospace",
  "editor.fontWeight": "500",
  "explorer.decorations.colors": true,
  // "colorTabs.config": [
  //   {
  //     "regex": ".*/mobile/.*",
  //     "color": "#dd3161",
  //     "label": "MOBILE"
  //   },
